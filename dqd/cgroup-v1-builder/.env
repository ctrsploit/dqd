VERSION=v0.1.1
IMAGE=cgroup-v1-builder
COMPOSE_PROJECT_NAME=cgroup-v1-builder
# Builder VM disk. The default 10G is too small: a cgroup-v1 k8s calico build
# fills ~6G of BuildKit cache, then the image export (--load) needs ~2-3G more,
# and the build fails at "importing to docker" with "no space left on device".
# 30G leaves comfortable headroom for nested k8s builds (init/calico/cluster).
SIZE=30G
