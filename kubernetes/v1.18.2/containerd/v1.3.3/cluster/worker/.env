VERSION=v0.1.2
IMAGE=kubernetes-v1.18.2-worker
SANDBOX_HOSTNAME=kubernetes-1-18-2-worker
BUILDER_NAME=docker-archive-builder2
BUILD_EXTRA_ARGS="--no-cache --add-host kubernetes-1-18-2:10.0.2.16 --add-host kubernetes-1-18-2-containerd-1-3-3:10.0.2.16"
SIZE=20G
# v1.18.2 (systemd 245 / Ubuntu 20.04) needs a cgroup-v1 environment
CI_DQD_BUILDER=dqd/cgroup-v1-builder
